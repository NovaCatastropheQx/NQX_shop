<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create New Order</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            margin: 0;
            background-color: #edf4fc;
            font-family: Arial, sans-serif;
            color: #333;
        }

        .page-container {
            width: 100%;
            max-width: 625px;
            margin: 24px auto 40px;
            padding: 0 26px;
        }

        .page-title {
            text-align: center;
            color: #2478df;
            font-size: 34px;
            font-weight: bold;
            margin-bottom: 36px;
        }

        .order-card {
            background-color: white;
            border-radius: 13px;
            padding: 27px;
        }

        .form-group {
            margin-bottom: 17px;
        }

        .form-label {
            display: block;
            color: #2478df;
            font-size: 17px;
            font-weight: bold;
            margin-bottom: 7px;
        }

        .form-control,
        .form-select {
            width: 100%;
            height: 43px;
            border: 1px solid #d6d6d6;
            border-radius: 6px;
            padding: 8px 13px;
            font-size: 14px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #2478df;
            box-shadow: 0 0 0 0.15rem rgba(36, 120, 223, 0.15);
        }

        .place-btn {
            width: 100%;
            height: 50px;
            margin-top: 12px;
            background-color: #2478df;
            border-color: #2478df;
            color: white;
            font-size: 18px;
            font-weight: bold;
            border-radius: 7px;
        }

        .back-btn {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
            height: 50px;
            margin-top: 17px;

            background-color: #f5a500;
            border-color: #f5a500;
            color: white;

            font-size: 18px;
            font-weight: bold;
            border-radius: 7px;
            text-decoration: none;
        }

        .place-btn:hover {
            background-color: #1768c8;
            border-color: #1768c8;
            color: white;
        }

        .back-btn:hover {
            background-color: #dc9400;
            border-color: #dc9400;
            color: white;
        }
    </style>

</head>

<body>

    <div class="page-container">

        <h1 class="page-title">
            Create New Order
        </h1>

        <div class="order-card">

            <form action="/orders/add" method="POST">

                <div class="form-group">

                    <label class="form-label">
                        Customer Name
                    </label>

                    <input
                        type="text"
                        name="customerName"
                        class="form-control"
                        placeholder="Enter your name"
                        required
                        minlength="2"
                        maxlength="100"
                    >

                </div>


                <div class="form-group">

                    <label class="form-label">
                        Product Name
                    </label>

                    <select
                        name="productName"
                        class="form-select"
                        required
                    >

                        <option value="">
                            Select Product
                        </option>

                        <% products.forEach(product => { %>

                            <option value="<%= product.productName %>">
                                <%= product.productName %>
                            </option>

                        <% }); %>

                    </select>

                </div>


                <div class="form-group">

                    <label class="form-label">
                        Quantity
                    </label>

                    <input
                        type="number"
                        name="quantity"
                        class="form-control"
                        placeholder="Enter quantity"
                        min="1"
                        step="1"
                        required
                    >

                </div>


                <div class="form-group">

                    <label class="form-label">
                        Order Date
                    </label>

                    <input
                        type="date"
                        name="orderDate"
                        class="form-control"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn place-btn"
                >
                    Place Order
                </button>


                <a
                    href="/orders"
                    class="btn back-btn"
                >
                    Go Back
                </a>

            </form>

        </div>

    </div>

</body>

</html>