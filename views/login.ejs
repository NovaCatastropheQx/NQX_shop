<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body style="background-color:#edf4fc;">

    <div
        class="container"
        style="max-width:500px; margin-top:80px;"
    >

        <h1 class="text-center text-primary fw-bold mb-4">
            Login
        </h1>

        <div class="card shadow p-4">

            <% if (error) { %>

                <div class="alert alert-danger">
                    <%= error %>
                </div>

            <% } %>

            <form action="/login" method="POST">

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Username
                    </label>

                    <input
                        type="text"
                        name="username"
                        class="form-control"
                        required
                    >

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Password
                    </label>

                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        required
                    >

                </div>

                <button
                    type="submit"
                    class="btn btn-primary w-100"
                >
                    Login
                </button>

            </form>

        </div>

    </div>

</body>

</html>