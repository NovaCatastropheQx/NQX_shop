<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Product Orders</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            margin: 0;
            background-color: #edf4fc;
            font-family: Arial, sans-serif;
            color: #333;
        }

        .page-container {
            width: 96%;
            max-width: 1200px;
            margin: 25px auto;
        }

        .page-title {
            text-align: center;
            color: #2478df;
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 28px;
        }

        .order-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

        .order-table thead th {
            background-color: #2478df;
            color: white;
            font-size: 17px;
            font-weight: bold;
            padding: 13px 16px;
            border: none;
            vertical-align: middle;
        }

        .order-table tbody td {
            padding: 9px 16px;
            font-size: 16px;
            border: none;
            vertical-align: middle;
        }

        .order-table tbody tr:nth-child(odd) td {
            background-color: #e5e8eb;
        }

        .order-table tbody tr:nth-child(even) td {
            background-color: white;
        }

        .action-cell {
            white-space: nowrap;
        }

        .update-btn {
            background-color: #2478df;
            border-color: #2478df;
            color: white;
            padding: 7px 16px;
            margin-right: 6px;
        }

        .delete-btn {
            background-color: #f5a500;
            border-color: #f5a500;
            color: white;
            padding: 7px 16px;
        }

        .create-container {
            text-align: center;
            margin-top: 68px;
        }

        .create-btn {
            background-color: #2478df;
            border-color: #2478df;
            color: white;
            font-size: 18px;
            font-weight: bold;
            padding: 11px 25px;
        }

        .update-btn:hover,
        .create-btn:hover {
            background-color: #1768c8;
            border-color: #1768c8;
            color: white;
        }

        .delete-btn:hover {
            background-color: #dc9400;
            border-color: #dc9400;
            color: white;
        }
    </style>
</head>

<body>

    <div class="page-container">

        <h1 class="page-title">
            Product Orders
        </h1>

        <table class="order-table">

            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Order Date</th>
                    <th>Total Price</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <% orders.forEach(order => { %>

                    <tr>

                        <td>
                            <%= order.customerName %>
                        </td>

                        <td>
                            <%= order.productName %>
                        </td>

                        <td>
                            <%= order.quantity %>
                        </td>

                        <td>
                            <%= new Date(order.orderDate).toLocaleDateString() %>
                        </td>

                        <td>
                            <%= order.totalPrice %> VND
                        </td>

                        <td class="action-cell">

                            <a
                                href="/orders/update/<%= order._id %>"
                                class="btn update-btn"
                            >
                                Update
                            </a>

                            <a
                                href="/orders/delete/<%= order._id %>"
                                class="btn delete-btn"
                            >
                                Delete
                            </a>

                        </td>

                    </tr>

                <% }); %>

            </tbody>

        </table>

        <div class="create-container">

            <a
                href="/orders/add"
                class="btn create-btn"
            >
                Create New Order
            </a>

        </div>

    </div>

</body>

</html>